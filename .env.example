# ============================================================
# Resume Go Offer — 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# ============================================================

# ── 应用 ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI 大模型 (必需) ──
# 支持 OpenAI / DeepSeek / 智谱 GLM 等兼容 API 提供商
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── AI 提取（可选，默认复用 OpenAI）──
# 可用更快的模型（如 DeepSeek）加速简历提取
# AI_EXTRACT_API_KEY=sk-xxxx
# AI_EXTRACT_BASE_URL=https://api.deepseek.com/v1
# AI_EXTRACT_MODEL=deepseek-chat

# ── 附件解析（可选，默认复用主对话模型）──
# 用于岗位/简历附件文字解析，追求速度可用更快的模型（如智谱 glm-4-air）
# AI_ATTACHMENT_MODEL=glm-4-air

# ── 视觉模型（可选，用于岗位截图解析）──
# AI_VISION_MODEL=glm-4v

# ── LangGraph Agent 模式（可选）──
# LANGGRAPH_ENABLED=true
# LANGCHAIN_API_KEY=ls_xxxx
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=resume-go-offer-dev
# LANGCHAIN_TRACING_SAMPLING_RATE=0.05

# ── Token 记账：模型价格覆盖（可选，元/1M tokens）──
# 不设置时用 lib/billing/pricing.ts 内置价格快照。记账快照单价，改价不影响历史账。
# PRICE_JSON='{"glm-4-plus":{"input":5,"output":5},"deepseek-chat":{"input":2,"output":8}}'

# ── BYOK：用户自带 API Key 的加密主密钥（生产必填，64 位 hex）──
# openssl rand -hex 32 生成。缺失时：开发环境用进程内临时密钥（重启后已存配置失效），生产直接报错。
# BYOK_MASTER_KEY=xxxx

# ── 智谱 API（可选，图片解析用）──
# ZHIPU_API_KEY=xxxx

# ── Authing OIDC 登录 ──
# AUTHING_ISSUER=https://xxx.authing.cn/oidc
# AUTHING_APP_ID=xxx
# AUTHING_APP_SECRET=xxx

# ── 微信开放平台 ──
# WECHAT_APP_ID=xxx
# WECHAT_APP_SECRET=xxx

# ── GitHub OAuth ──
# 在 GitHub Settings → Developer settings → OAuth Apps 创建应用
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/github/callback
# GITHUB_CLIENT_ID=xxx
# GITHUB_CLIENT_SECRET=xxx

# ── Sentry 错误监控（可选）──
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
# SENTRY_AUTH_TOKEN=xxxx

# ── MinerU PDF 解析（可选）──
# MINERU_TOKEN=xxx
